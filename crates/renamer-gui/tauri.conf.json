{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenamerAnime",
  "version": "2.0.0",
  "identifier": "io.github.noobdragon000.renameranime",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RenamerAnime v2.0",
        "width": 1220,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
